{
  "name": "@keel/specs",
  "version": "0.1.0",
  "description": "Machine-readable component specs \u2014 the shared source of truth for story matrices, parity tests and generated documentation.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:packaging": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doosemavis/keel.git",
    "directory": "packages/specs"
  },
  "homepage": "https://github.com/doosemavis/keel#readme",
  "bugs": {
    "url": "https://github.com/doosemavis/keel/issues"
  },
  "author": "Moose Davis",
  "engines": {
    "node": ">=22"
  }
}
