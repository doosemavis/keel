{
  "name": "@keel/react",
  "version": "0.1.0",
  "description": "Keel components for React 19 \u2014 accessible behaviour from React Aria, styling from the shared Keel token layer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node build-css.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:packaging": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css components.css"
  },
  "peerDependencies": {
    "@keel/tokens": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-aria-components": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@keel/contracts": "workspace:*",
    "@keel/tokens": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@keel/behaviors": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/dom": "^10.4.0",
    "jsdom": "^28.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doosemavis/keel.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/doosemavis/keel#readme",
  "bugs": {
    "url": "https://github.com/doosemavis/keel/issues"
  },
  "author": "Moose Davis"
}
