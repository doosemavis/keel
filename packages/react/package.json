{
  "name": "@keel/react",
  "version": "0.1.0",
  "description": "Keel components for React 19 — accessible behaviour from React Aria, styling from the shared Keel token layer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node lint-css.js && tsdown && node build-css.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:packaging": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css components.css",
    "lint:css": "node lint-css.js"
  },
  "peerDependencies": {
    "@keel/tokens": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-aria-components": "^1.21.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@keel/contracts": "*",
    "@keel/tokens": "*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.11",
    "@keel/behaviors": "*",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/dom": "^10.4.0",
    "jsdom": "^28.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doosemavis/keel.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/doosemavis/keel#readme",
  "bugs": {
    "url": "https://github.com/doosemavis/keel/issues"
  },
  "author": "Moose Davis",
  "engines": {
    "node": ">=22"
  }
}
