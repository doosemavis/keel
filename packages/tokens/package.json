{
  "name": "@keel/tokens",
  "version": "0.1.0",
  "description": "Keel design tokens \u2014 DTCG source compiled to CSS custom properties and TypeScript.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.dark.css": "./dist/tokens.dark.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.js && node contrast.js && tsdown",
    "contrast": "node build.js && node contrast.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:packaging": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints tokens.css tokens.dark.css tokens.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.24",
    "style-dictionary": "^5.5.2",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doosemavis/keel.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/doosemavis/keel#readme",
  "bugs": {
    "url": "https://github.com/doosemavis/keel/issues"
  },
  "author": "Moose Davis",
  "engines": {
    "node": ">=22"
  }
}
