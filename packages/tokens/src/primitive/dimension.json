{
  "$description": "Spacing, radius and border-width scales. Spacing is a 4px base step expressed in rem so it respects user font-size settings.",
  "space": {
    "$type": "dimension",
    "0":  { "$value": "0rem" },
    "25": { "$value": "0.125rem", "$description": "2px" },
    "50": { "$value": "0.25rem",  "$description": "4px" },
    "75": { "$value": "0.375rem", "$description": "6px" },
    "100": { "$value": "0.5rem",  "$description": "8px" },
    "150": { "$value": "0.75rem", "$description": "12px" },
    "200": { "$value": "1rem",    "$description": "16px" },
    "300": { "$value": "1.5rem",  "$description": "24px" },
    "400": { "$value": "2rem",    "$description": "32px" },
    "500": { "$value": "2.5rem",  "$description": "40px" },
    "600": { "$value": "3rem",    "$description": "48px" },
    "800": { "$value": "4rem",    "$description": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0rem" },
    "sm":   { "$value": "0.25rem" },
    "md":   { "$value": "0.375rem" },
    "lg":   { "$value": "0.5rem" },
    "xl":   { "$value": "0.75rem" },
    "full": { "$value": "9999rem" }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "none":  { "$value": "0rem" },
      "thin":  { "$value": "0.0625rem", "$description": "1px" },
      "thick": { "$value": "0.125rem",  "$description": "2px" }
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$description": "Minimum hit target height per control size. `md` and up clear the 44px WCAG 2.5.5 AAA target; `sm` is for dense data UI and must not be the only way to reach an action.",
      "sm": { "$value": "1.75rem", "$description": "28px" },
      "md": { "$value": "2.25rem", "$description": "36px" },
      "lg": { "$value": "2.75rem", "$description": "44px" }
    }
  }
}
