{
  "$description": "DARK theme overrides. Carries only the roles whose value differs from the light theme — merged over semantic/color.json at build time, so adding a role means touching one file, not two. Note the inversion in the fills: accent and danger get LIGHTER here while their text goes dark, which is why fg.onAccent and fg.onDanger are separate roles.",
  "color": {
    "$type": "color",
    "bg": {
      "canvas":  { "$value": "{color.pond.950}" },
      "surface": { "$value": "{color.pond.900}" },
      "subtle":  { "$value": "{color.pond.900}" },
      "muted":   { "$value": "{color.pond.800}" },
      "mutedHover":  { "$value": "{color.pond.700}" },
      "mutedActive": { "$value": "{color.pond.600}" },
      "inverse": { "$value": "{color.pond.100}" },
      "accent":       { "$value": "{color.lotus.400}", "$description": "Lighter than light-theme accent so dark text on it clears AA." },
      "accentHover":  { "$value": "{color.lotus.300}" },
      "accentActive": { "$value": "{color.lotus.200}" },
      "accentSubtle": { "$value": "{color.lotus.950}" },
      "successSubtle": { "$value": "{color.leaf.900}" },
      "warningSubtle": { "$value": "{color.gold.900}" },
      "dangerSubtle":  { "$value": "{color.russet.900}" },
      "danger":       { "$value": "{color.russet.300}", "$description": "Follows the same inversion as accent — light fill, dark label — so destructive actions stay consistent with the rest of the system in dark mode." },
      "dangerHover":  { "$value": "{color.russet.100}" },
      "dangerActive": { "$value": "{color.russet.50}" },
      "disabled":     { "$value": "{color.pond.800}" }
    },
    "fg": {
      "default":  { "$value": "{color.pond.50}" },
      "muted":    { "$value": "{color.pond.300}" },
      "subtle":   { "$value": "{color.pond.400}", "$description": "pond.500 is tuned for AA on a white canvas and is too dark to carry text here, so the dark theme steps one rung lighter." },
      "onAccent": { "$value": "{color.pond.950}" },
      "onDanger": { "$value": "{color.pond.950}" },
      "onInverse":{ "$value": "{color.pond.950}" },
      "accent":   { "$value": "{color.lotus.300}" },
      "success":  { "$value": "{color.leaf.300}" },
      "warning":  { "$value": "{color.gold.300}" },
      "danger":   { "$value": "{color.russet.300}" },
      "disabled": { "$value": "{color.pond.600}" }
    },
    "border": {
      "default": { "$value": "{color.pond.700}" },
      "muted":   { "$value": "{color.pond.800}" },
      "control": { "$value": "{color.pond.500}" },
      "strong":  { "$value": "{color.pond.400}" },
      "accent":  { "$value": "{color.lotus.400}" },
      "danger":  { "$value": "{color.russet.300}" },
      "disabled":{ "$value": "{color.pond.800}" }
    },
    "focus": {
      "ring": { "$value": "{color.lotus.300}" }
    }
  }
}
