{
  "name": "keel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Keel \u2014 a design system with a shared token foundation and verified cross-framework parity.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @keel/workbench dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint:packaging": "turbo run lint:packaging",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doosemavis/keel.git"
  }
}
